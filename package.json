{
  "name": "@enk0ded/watcher",
  "version": "0.5.0-rc.0",
  "description": "A high-performance file system watcher for Node.js, written in Rust and exposed via N-API bindings",
  "keywords": [
    "file system",
    "file system watcher",
    "napi-rs",
    "watcher"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ENK0DED/watcher"
  },
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --esm --release",
    "build:debug": "napi build --platform --esm",
    "create-npm-dirs": "napi create-npm-dirs",
    "format": "oxfmt && cargo fmt",
    "lint": "oxlint --fix",
    "prepublishOnly": "napi prepublish -t npm",
    "preversion": "napi build --platform --esm && git add .",
    "typecheck": "tsc -p . && tsc -p __test__",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/bun": "latest",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "napi": {
    "binaryName": "watcher",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-linux-android"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
